<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test fixture: an app with a ProjectReference. Tests copy it next to a copy of SampleLib. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SampleLib/SampleLib.fsproj" />
  </ItemGroup>

</Project>
